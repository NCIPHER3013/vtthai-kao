{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pos-lite",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/__env.js"]
  }
}
